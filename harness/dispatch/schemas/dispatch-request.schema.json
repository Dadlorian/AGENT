{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentic:seam:dispatch:request:0.1",
  "title": "DispatchRequest",
  "description": "The seam's request, published as a file so every dispatcher validates against one copy of the contract instead of hand-writing field checks inside a shim (F-b1-02). What to do is in the document; how it will be judged is a handle, never a body.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "dispatch_id",
    "idempotency_key",
    "document",
    "criterion_ref",
    "actor",
    "budget",
    "deadline",
    "isolation",
    "correlation"
  ],
  "properties": {
    "request_version": {"const": "urn:agentic:seam:dispatch:0.1"},
    "dispatch_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
    "previous_dispatch_id": {"type": "string"},
    "idempotency_key": {"type": "string", "minLength": 1, "maxLength": 255},
    "document": {
      "type": "object",
      "required": ["document_id", "workflow_ref", "payload", "definition_of_done"],
      "properties": {
        "document_id": {"type": "string", "minLength": 1},
        "workflow_ref": {"type": "string", "minLength": 1},
        "definition_of_done": {
          "type": "object",
          "required": ["criterion_ref"],
          "properties": {"criterion_ref": {"type": "string", "minLength": 1}}
        }
      }
    },
    "criterion_ref": {"type": "string", "minLength": 1},
    "actor": {
      "type": "object",
      "required": ["subject", "delegation_chain"],
      "properties": {
        "subject": {"type": "string", "minLength": 1},
        "delegation_chain": {"type": "array", "minItems": 1}
      }
    },
    "budget": {
      "type": "object",
      "required": ["ceiling_micros", "currency", "on_exceed"],
      "properties": {
        "ceiling_micros": {"type": "integer", "minimum": 0},
        "currency": {"type": "string"},
        "on_exceed": {"const": "terminate_unit"}
      }
    },
    "deadline": {
      "type": "object",
      "required": ["not_after", "max_duration_s"],
      "properties": {
        "not_after": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
        "max_duration_s": {"type": "integer", "minimum": 1},
        "cancel_grace_s": {"type": "integer", "minimum": 1}
      }
    },
    "isolation": {
      "type": "object",
      "required": ["profile", "egress"],
      "properties": {
        "profile": {"type": "string", "minLength": 1},
        "egress": {"type": "string", "enum": ["none", "broker-only", "network"]}
      }
    },
    "correlation": {
      "type": "object",
      "required": ["run_id", "root_dispatch_id"],
      "properties": {
        "run_id": {"type": "string", "minLength": 1},
        "root_dispatch_id": {"type": "string", "minLength": 1},
        "correlation_id": {"type": "string"}
      }
    },
    "context": {
      "type": "object",
      "description": "What this unit receives, declared rather than implied.",
      "properties": {
        "receives": {"type": "array"},
        "folds_back": {"type": "string"}
      }
    }
  }
}
