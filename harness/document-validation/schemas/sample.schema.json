{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agentic:harness:document-validation:sample:0.1",
  "title": "Harness fixture: a richer keyword mix than entry.schema.json alone exercises",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "tags"],
  "properties": {
    "kind": {"$ref": "#/definitions/kind"},
    "tags": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "contains": {"const": "required-tag"}
    },
    "amount": {"type": "integer", "minimum": 0}
  },
  "if": {"properties": {"kind": {"const": "priced"}}},
  "then": {"required": ["amount"]},
  "definitions": {
    "kind": {"type": "string", "enum": ["priced", "free"]}
  }
}
